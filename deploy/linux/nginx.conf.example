# Replace chaingain.example.com with your real domain before installation.
# This is HTTP bootstrap only. Add HTTPS with Certbot before accepting wallets.
limit_req_zone $binary_remote_addr zone=chaingain_api:10m rate=10r/s;

server {
    listen 80;
    listen [::]:80;
    server_name chaingain.example.com;
    client_max_body_size 1m;

    location /api/ {
        limit_req zone=chaingain_api burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}

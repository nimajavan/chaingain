[Unit]
Description=ChainGain web and read-only API
After=network.target

[Service]
Type=simple
User=chaingain
Group=chaingain
WorkingDirectory=/opt/chaingain/app
Environment=NODE_ENV=production
EnvironmentFile=/etc/chaingain/web.env
ExecStart=/usr/local/bin/chaingain-node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/chaingain/app/.next/cache /var/lib/chaingain
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target

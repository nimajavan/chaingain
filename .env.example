# Public network configuration. Use Nile first; switch to mainnet only after every launch gate passes.
DATABASE_PATH=/var/lib/chaingain/chaingain.sqlite
# Keep false until real testnet acceptance and independent contract review.
SALES_ENABLED=false
TRON_NETWORK=nile
TRON_FULL_HOST=https://nile.trongrid.io
TRON_EVENT_API_BASE=https://nile.trongrid.io
TRON_PAYMENT_TOKEN_ADDRESS=
TRON_LOTTERY_ADDRESS=
TRON_VRF_ADAPTER_ADDRESS=
TRON_WINK_TOKEN_ADDRESS=
TRON_WINK_WRAPPER_ADDRESS=
TRON_ADMIN_ADDRESS=
TRON_TREASURY_ADDRESS=

# Server-side API credential. Configure as a hosted/GitHub secret, never commit its value.
TRONGRID_API_KEY=

# Permissionless draw-keeper account. Keep only a small TRX balance and no admin/treasury permission.
# Configure the private key only in the secret manager; never paste it into this file or chat.
TRON_AUTOMATION_PRIVATE_KEY=
# One-time deployment secret. Remove it after deployment; never reuse it for admin/treasury.
TRON_DEPLOYER_PRIVATE_KEY=
DEPLOY_EXECUTE=false
DEPLOY_FEE_LIMIT_SUN=1000000000
AUTOMATION_EXECUTE=false
AUTOMATION_MIN_TRX=20
AUTOMATION_FEE_LIMIT_SUN=150000000

# Deployment parameters (atomic USDT units and seconds).
LOTTERY_TICKET_PRICE=10000000
LOTTERY_MINIMUM_PLAYERS=500
LOTTERY_MAXIMUM_TICKETS_PER_WALLET=100
LOTTERY_RANDOMNESS_TIMEOUT=86400
WINK_CALLBACK_GAS_LIMIT=500000
WINK_REQUEST_CONFIRMATIONS=3
